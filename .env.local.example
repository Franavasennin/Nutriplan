# ─── Copia este archivo a .env.local y rellena los valores reales ───────────────
# .env.local NUNCA debe subirse a Git (ya está en .gitignore)

# Supabase (Project Settings → API en el dashboard de Supabase)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu_anon_key_aqui

# Mistral AI — proveedor de fallback (https://console.mistral.ai/api-keys)
VITE_API_KEY=tu_mistral_api_key_aqui

# Google Gemini — proveedor principal (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui
