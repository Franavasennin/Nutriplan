# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Salida generada por /graphify (grafo de conocimiento, no es código fuente)
graphify-out/

# Artefactos temporales de axe-core CLI (auditorías de accesibilidad puntuales)
.axe-tmp/

# Salida de cobertura de Vitest (se regenera con npm run test:coverage)
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Playwright (E2E) — informes y artefactos regenerables
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
